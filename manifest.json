{
  "manifest_version": 3,
  "name": "Focus Guard",
  "version": "1.0",
  "description": "Block distracting websites while you study.",
  "permissions": ["storage"],
  "action": { "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}